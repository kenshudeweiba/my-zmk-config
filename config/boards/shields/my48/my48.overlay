#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>


/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios =
            <&gpio0 22 GPIO_ACTIVE_HIGH>,
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1 0 GPIO_ACTIVE_HIGH>,
            <&gpio0 11 GPIO_ACTIVE_HIGH>,
            <&gpio1 4 GPIO_ACTIVE_HIGH>,
            <&gpio1 6 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>;

        row-gpios =
            <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(255,255) RC(3,4) RC(255,255) RC(3,6) RC(3,7) RC(255,255) RC(255,255) RC(255,255) RC(3,11)
        >;
    };

    key_xy_0: key_xy_0 { compatible = "zmk,key-position"; #key-cells = <0>; x = <0>; y = <0>; };
    key_xy_1: key_xy_1 { compatible = "zmk,key-position"; #key-cells = <0>; x = <19>; y = <0>; };
    key_xy_2: key_xy_2 { compatible = "zmk,key-position"; #key-cells = <0>; x = <38>; y = <0>; };
    key_xy_3: key_xy_3 { compatible = "zmk,key-position"; #key-cells = <0>; x = <57>; y = <0>; };
    key_xy_4: key_xy_4 { compatible = "zmk,key-position"; #key-cells = <0>; x = <76>; y = <0>; };
    key_xy_5: key_xy_5 { compatible = "zmk,key-position"; #key-cells = <0>; x = <95>; y = <0>; };
    key_xy_6: key_xy_6 { compatible = "zmk,key-position"; #key-cells = <0>; x = <114>; y = <0>; };
    key_xy_7: key_xy_7 { compatible = "zmk,key-position"; #key-cells = <0>; x = <133>; y = <0>; };
    key_xy_8: key_xy_8 { compatible = "zmk,key-position"; #key-cells = <0>; x = <152>; y = <0>; };
    key_xy_9: key_xy_9 { compatible = "zmk,key-position"; #key-cells = <0>; x = <171>; y = <0>; };
    key_xy_10: key_xy_10 { compatible = "zmk,key-position"; #key-cells = <0>; x = <190>; y = <0>; };
    key_xy_11: key_xy_11 { compatible = "zmk,key-position"; #key-cells = <0>; x = <209>; y = <0>; };
    key_xy_12: key_xy_12 { compatible = "zmk,key-position"; #key-cells = <0>; x = <0>; y = <19>; };
    key_xy_13: key_xy_13 { compatible = "zmk,key-position"; #key-cells = <0>; x = <19>; y = <19>; };
    key_xy_14: key_xy_14 { compatible = "zmk,key-position"; #key-cells = <0>; x = <38>; y = <19>; };
    key_xy_15: key_xy_15 { compatible = "zmk,key-position"; #key-cells = <0>; x = <57>; y = <19>; };
    key_xy_16: key_xy_16 { compatible = "zmk,key-position"; #key-cells = <0>; x = <76>; y = <19>; };
    key_xy_17: key_xy_17 { compatible = "zmk,key-position"; #key-cells = <0>; x = <95>; y = <19>; };
    key_xy_18: key_xy_18 { compatible = "zmk,key-position"; #key-cells = <0>; x = <114>; y = <19>; };
    key_xy_19: key_xy_19 { compatible = "zmk,key-position"; #key-cells = <0>; x = <133>; y = <19>; };
    key_xy_20: key_xy_20 { compatible = "zmk,key-position"; #key-cells = <0>; x = <152>; y = <19>; };
    key_xy_21: key_xy_21 { compatible = "zmk,key-position"; #key-cells = <0>; x = <171>; y = <19>; };
    key_xy_22: key_xy_22 { compatible = "zmk,key-position"; #key-cells = <0>; x = <190>; y = <19>; };
    key_xy_23: key_xy_23 { compatible = "zmk,key-position"; #key-cells = <0>; x = <209>; y = <19>; };
    key_xy_24: key_xy_24 { compatible = "zmk,key-position"; #key-cells = <0>; x = <0>; y = <38>; };
    key_xy_25: key_xy_25 { compatible = "zmk,key-position"; #key-cells = <0>; x = <19>; y = <38>; };
    key_xy_26: key_xy_26 { compatible = "zmk,key-position"; #key-cells = <0>; x = <38>; y = <38>; };
    key_xy_27: key_xy_27 { compatible = "zmk,key-position"; #key-cells = <0>; x = <57>; y = <38>; };
    key_xy_28: key_xy_28 { compatible = "zmk,key-position"; #key-cells = <0>; x = <76>; y = <38>; };
    key_xy_29: key_xy_29 { compatible = "zmk,key-position"; #key-cells = <0>; x = <95>; y = <38>; };
    key_xy_30: key_xy_30 { compatible = "zmk,key-position"; #key-cells = <0>; x = <114>; y = <38>; };
    key_xy_31: key_xy_31 { compatible = "zmk,key-position"; #key-cells = <0>; x = <133>; y = <38>; };
    key_xy_32: key_xy_32 { compatible = "zmk,key-position"; #key-cells = <0>; x = <152>; y = <38>; };
    key_xy_33: key_xy_33 { compatible = "zmk,key-position"; #key-cells = <0>; x = <171>; y = <38>; };
    key_xy_34: key_xy_34 { compatible = "zmk,key-position"; #key-cells = <0>; x = <190>; y = <38>; };
    key_xy_35: key_xy_35 { compatible = "zmk,key-position"; #key-cells = <0>; x = <209>; y = <38>; };
    key_xy_36: key_xy_36 { compatible = "zmk,key-position"; #key-cells = <0>; x = <0>; y = <57>; };
    key_xy_37: key_xy_37 { compatible = "zmk,key-position"; #key-cells = <0>; x = <19>; y = <57>; };
    key_xy_38: key_xy_38 { compatible = "zmk,key-position"; #key-cells = <0>; x = <38>; y = <57>; };
    key_xy_39: key_xy_39 { compatible = "zmk,key-position"; #key-cells = <0>; x = <57>; y = <57>; };
    key_xy_40: key_xy_40 { compatible = "zmk,key-position"; #key-cells = <0>; x = <76>; y = <57>; };
    key_xy_41: key_xy_41 { compatible = "zmk,key-position"; #key-cells = <0>; x = <95>; y = <57>; };
    key_xy_42: key_xy_42 { compatible = "zmk,key-position"; #key-cells = <0>; x = <114>; y = <57>; };
    key_xy_43: key_xy_43 { compatible = "zmk,key-position"; #key-cells = <0>; x = <133>; y = <57>; };
    key_xy_44: key_xy_44 { compatible = "zmk,key-position"; #key-cells = <0>; x = <152>; y = <57>; };
    key_xy_45: key_xy_45 { compatible = "zmk,key-position"; #key-cells = <0>; x = <171>; y = <57>; };
    key_xy_46: key_xy_46 { compatible = "zmk,key-position"; #key-cells = <0>; x = <190>; y = <57>; };
    key_xy_47: key_xy_47 { compatible = "zmk,key-position"; #key-cells = <0>; x = <209>; y = <57>; };

    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "My48 Keyboard";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <
            &key_xy_0 &key_xy_1 &key_xy_2 &key_xy_3 &key_xy_4 &key_xy_5 &key_xy_6 &key_xy_7 &key_xy_8 &key_xy_9 &key_xy_10 &key_xy_11
            &key_xy_12 &key_xy_13 &key_xy_14 &key_xy_15 &key_xy_16 &key_xy_17 &key_xy_18 &key_xy_19 &key_xy_20 &key_xy_21 &key_xy_22 &key_xy_23
            &key_xy_24 &key_xy_25 &key_xy_26 &key_xy_27 &key_xy_28 &key_xy_29 &key_xy_30 &key_xy_31 &key_xy_32 &key_xy_33 &key_xy_34 &key_xy_35
            &key_xy_36 &key_xy_37 &key_xy_38 &key_xy_39 &key_xy_40 &key_xy_41 &key_xy_42 &key_xy_43 &key_xy_44 &key_xy_45 &key_xy_46 &key_xy_47
        >;
    };

    leds {
        compatible = "gpio-leds";
        caps_lock_led: led_0 {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
        };
        bt_led: led_1 {
            gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        };
    };

    chosen {
        zmk,physical-layout = &physical_layout;
    };
};
