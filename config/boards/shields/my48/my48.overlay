#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    // 1. 矩阵行列映射
    kscan0: kscan_composite {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row"; // 如果你二极管黑圈朝向行线，用 col2row；反之用 row2col

        row-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW0 -> P0.17
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 -> P0.20
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 -> P0.22
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3 -> P0.24
            ;

        col-gpios
            = <&gpio1 0  GPIO_ACTIVE_HIGH> // COL0 -> P1.00
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // COL1 -> P0.11
            , <&gpio1 4  GPIO_ACTIVE_HIGH> // COL2 -> P1.04
            , <&gpio1 6  GPIO_ACTIVE_HIGH> // COL3 -> P1.06
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // COL4 -> P0.31
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // COL5 -> P0.29
            , <&gpio0 2  GPIO_ACTIVE_HIGH> // COL6 -> P0.02
            , <&gpio1 15 GPIO_ACTIVE_HIGH> // COL7 -> P1.15
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // COL8 -> P1.13
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // COL9 -> P1.11
            , <&gpio0 8  GPIO_ACTIVE_HIGH> // COL10 -> P0.08
            , <&gpio0 6  GPIO_ACTIVE_HIGH> // COL11 -> P0.06
            ;
    };

    // 2. 转换矩阵（告诉系统这 48 个点怎么排成 4x12）
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    // 3. LED 指示灯配置
    leds {
        compatible = "gpio-leds";
        left_led: led_0 {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; // P0.10 (D16)
            label = "Left LED";
        };
        right_led: led_1 {
            gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;  // P0.06 (D10)
            label = "Right LED";
        };
    };
};
