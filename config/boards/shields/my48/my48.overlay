#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    // 定义 Tap-Hold (点按/按住) 行为参数
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    // 键盘矩阵扫描配置
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row"; // 二极管方向：列到行
        
        // 列引脚 (Cols 0-11) - 对应你提供的 CONFIG_ZMK_GPIO_COL_x
        col-gpios = 
            <&gpio0 22 GPIO_ACTIVE_HIGH>,  // P0_22
            <&gpio0 24 GPIO_ACTIVE_HIGH>,  // P0_24
            <&gpio1 0  GPIO_ACTIVE_HIGH>,  // P1_00
            <&gpio0 11 GPIO_ACTIVE_HIGH>,  // P0_11
            <&gpio1 4  GPIO_ACTIVE_HIGH>,  // P1_04
            <&gpio1 6  GPIO_ACTIVE_HIGH>,  // P1_06
            <&gpio0 31 GPIO_ACTIVE_HIGH>,  // P0_31
            <&gpio0 29 GPIO_ACTIVE_HIGH>,  // P0_29
            <&gpio0 2  GPIO_ACTIVE_HIGH>,  // P0_02
            <&gpio1 15 GPIO_ACTIVE_HIGH>,  // P1_15
            <&gpio1 13 GPIO_ACTIVE_HIGH>,  // P1_13
            <&gpio1 11 GPIO_ACTIVE_HIGH>;  // P1_11

        // 行引脚 (Rows 0-3) - 对应你提供的 CONFIG_ZMK_GPIO_ROW_x
        row-gpios = 
            <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // P0_06
            <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // P0_08
            <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // P0_17
            <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // P0_20
            
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };

    // 物理布局与矩阵变换 (Map)
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(255,255) RC(3,4) RC(255,255) RC(3,6) RC(3,7) RC(255,255) RC(255,255) RC(255,255) RC(3,11)
        >;
    };

    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
    };

    chosen {
        zmk,physical-layout = &physical_layout;
    };
};
