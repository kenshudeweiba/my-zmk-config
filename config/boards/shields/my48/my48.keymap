#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // 基础层 (Layer 0)
        default_layer {
            bindings = <
                &kp ESC    &kp Q      &kp W    &kp E     &kp R        &kp T     &kp Y         &kp U     &kp I     &kp O    &kp P     &kp BSPC
                &kp TAB    &kp A      &kp S    &kp D     &kp F        &kp G     &kp H         &kp J     &kp K     &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z      &kp X    &kp C     &kp V        &kp B     &kp N         &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
                &kp LCTRL  &kp LBRACK &kp LALT &none     &lt 1 SPACE  &none     &lt 2 SPACE   &kp RALT  &none     &none    &none     &kp RCTRL
            >;
        };

        // 低层 (Layer 1) - 按住左下角绿键触发
        lower_layer {
            bindings = <
                        // 第0行 ESC Q W E R T Y U I O P BSPC
                        &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
                        // 第1行 TAB A S D F G H J K L SEMI SQT
                        &none &none &none &none &none &none &kp LGUI &kp LEFT &kp DOWN &kp RIGHT &none &none
                        // 第2行 LSHFT Z X C V B N M COMMA DOT FSLH RSHFT
                        &none &none &none &none &none &none &none &none &none &none &none &none
                        // 第3行 LCTRL LBRACK LALT none LT1 none LT2 RALT none none none RCTRL
                        &none &none &none &none &trans &none &trans &none &none &none &none &none
            >;
        };

        fn_layer {
                    bindings = <
                        &none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
                        &none &kp F11 &kp F12 &none &none &none &none &none &none &none &none &none
                        &none &none &none &none &none &none &none &none &none &none &none &none
                        &none &none &none &none &trans &none &trans &none &none &none &none &none
                    >;
                };
    };
};
